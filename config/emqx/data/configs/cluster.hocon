      description = "transfer inventory IoT data to Kafka"
      enable = true
      fallback_actions = []
      last_modified_at = 1783512899768
      parameters {
        buffer {
          memory_overload_protection = true
          mode = memory
          per_partition_limit = "256MB"
          segment_bytes = "10MB"
        }
        compression = no_compression
        kafka_ext_headers = [
          {
            kafka_ext_header_key = clientid
            kafka_ext_header_value = "${clientid}"
