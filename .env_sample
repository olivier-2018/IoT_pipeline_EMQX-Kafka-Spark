# IoT Data Pipeline Configuration
# Customize these for your environment

# PostgreSQL
POSTGRES_PASSWORD=mypassword
POSTGRES_USER=postgres
POSTGRES_DB=iot_database

# EMQX (admin credentials)
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=public
EMQX_HOST=localhost
EMQX_PORT=18083

# EMQX API key (generate manually in EMQX UI or use cmd below)
# docker exec emqx emqx ctl api_keys add --name setup-key --desc "Setup script API key"
EMQX_API_KEY=
EMQX_API_SECRET=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_UI_KEY=

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=512m
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_TOTAL_EXECUTOR_CORES=2

# Data Generation
DATA_GENERATION_FREQUENCY_SECONDS=60  # Batch frequency (30-60 sec recommended)
DATA_GENERATION_BATCH_SIZE=500        # Total msg/sec target

# MQTT BROKER COMMUNICATION (EMQX)
# In Docker: use container name "emqx"; for local dev: use "localhost"
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_QOS=1
